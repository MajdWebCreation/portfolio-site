# Supabase — public values, safe to expose in the browser.
# Project: YM-Creations (wbrqbuctwzpobnvcsomt)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase secret key — elevated, server-only access for system actions.
#
# Read in exactly one module, lib/payments/admin-client.ts, and used only by
# the two flows that carry no session: the Mollie webhook and the direct debit
# activation the customer starts. Neither can run as a signed-in admin, and the
# alternative -- granting `anon` write access to the payment tables -- would
# make internal financial administration publicly writable.
#
# That client reads no cookies and keeps no session, so it can never adopt a
# visitor's. Everything an admin does still goes through the ordinary server
# client and row level security.
#
# Never expose this to the browser, never put it in a NEXT_PUBLIC_ variable,
# never write it to the database, never log it and never put it in a mail.
SUPABASE_SECRET_KEY=sb_secret_...

# The absolute URL of this site. Mollie needs it to reach the webhook and to
# send customers back after paying.
NEXT_PUBLIC_SITE_URL=https://ymcreations.com

# Mollie — payments and direct debit. A key starting with test_ puts the whole
# integration in test mode, so development needs no separate switch.
# Server-side only: it is never sent to the browser, never written to the
# database, never logged and never put in a mail or a URL.
MOLLIE_API_KEY=test_...

# Vercel Cron — the daily SEPA pre-notification pass.
#
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on the scheduled
# call. Without it the route refuses every request rather than running open,
# so a missing value cannot turn it into a public button that mails customers.
# Generate a long random value; server-only.
CRON_SECRET=

# Retention cron — the switch between counting and deleting.
#
# The daily retention job (api/cron/retention) selects what the retention
# policy says may go: quiet inquiries and leads after twelve months, and the
# bodies of non-fiscal customer mails. It only carries that out when this is
# exactly "true". Missing, empty or any other value is a dry run: the same
# selection, counts in the log and the response, and nothing removed. Leave it
# unset on a first deployment, read a few days of counts, then set it.
RETENTION_ENABLED=

# Payment return URLs — the signature on the `state` token.
#
# The page a customer lands on after paying used to carry the invoice number
# (?doc=YM-F-2026-000001). Those run in sequence, so anyone could count
# through them and read off whether an invoice existed. It now carries a token
# whose payload is encrypted and signed with keys derived from this value, so
# the URL names nothing and cannot be forged into naming something else.
#
# Deliberately its own secret, not the Mollie, Supabase or cron one: a value
# that signs public URLs must not be one whose leak costs anything else.
# Generate a long random value (for example `openssl rand -base64 48`);
# server-only, never a NEXT_PUBLIC_ variable, never logged, never in a mail.
#
# Changing it invalidates return links already handed out: those customers see
# the neutral "Bedankt" message instead of a status. Nothing else breaks.
PAYMENT_RETURN_SECRET=

# Google Analytics 4 — the property's measurement id (G-XXXXXXXXXX).
#
# Public by nature (it ends up in every visitor's browser), but it decides
# more than a tag: without it the consent card, the footer's "Cookie-
# instellingen" and the gtag script are not rendered at all, because there
# is nothing to ask about. With it, the tag is rendered only after the
# visitor's yes (components/consent/analytics-scripts.tsx); events are
# listed in lib/analytics/events.ts and checked by lib/analytics/guard.ts.
#
# Inlined at build time, so a change needs a new build. Leave it unset in
# local development unless you are checking the tag itself.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Analytics Data API and Search Console — the admin's analytics dashboard.
#
# The dashboard at /admin/analytics reads day aggregates that a daily job
# (api/cron/analytics-sync) fetches and stores in analytics_facts. Every
# provider is configured on its own: one that is missing is shown as "niet
# gekoppeld" and the others still sync. All values are server-only.
#
# Shared by both Google providers, one service account:
#   GOOGLE_SERVICE_ACCOUNT_EMAIL       …@….iam.gserviceaccount.com
#   GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY the account's private key: the PEM as
#                                      is, the PEM with newlines written as
#                                      \n, or the whole PEM base64-encoded
# Google Analytics 4 (scope analytics.readonly; the account needs Viewer on
# the property; the Analytics Data API enabled in its Cloud project):
#   GA4_PROPERTY_ID                    the numeric property id (Admin → Property
#                                      details), not the G-… measurement id
# Google Search Console (scope webmasters.readonly; the account added as a
# user with restricted permission on the property; the Search Console API
# enabled in its Cloud project):
#   GSC_SITE_URL                       the property exactly as Search Console
#                                      names it: sc-domain:ymcreations.com for
#                                      a domain property, or the URL prefix
#                                      with trailing slash, e.g.
#                                      https://ymcreations.com/
#
# The key is read in exactly one module (lib/analytics-admin/google-auth.ts),
# signs a JWT and goes nowhere else: never logged, never in the browser,
# never in the database, never in a mail. Tokens are kept per scope.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GA4_PROPERTY_ID=
GSC_SITE_URL=

# Bing Webmaster Tools — the Bing block of the analytics dashboard.
#
#   BING_WEBMASTER_API_KEY  Settings → API access → API key in Bing Webmaster
#                           Tools; sent to Bing only, never logged
#   BING_SITE_URL           the site exactly as registered there, e.g.
#                           https://ymcreations.com/
BING_WEBMASTER_API_KEY=
BING_SITE_URL=

# Analytics sync — the switch between counting and writing.
#
# The daily job and the admin's "Vernieuw nu" fetch the reports either way.
# Only when this is exactly "true" are the rows written to analytics_facts,
# runs recorded and facts older than 26 months removed. Missing, empty or
# any other value is a dry run: the same fetch, counts in the log and the
# response, and nothing stored. Leave it unset on a first deployment, read
# a few runs, then set it. Writing also needs SUPABASE_SECRET_KEY.
ANALYTICS_SYNC_ENABLED=

# Resend — the contact form, sending quotes and invoices, the direct debit
# activation mail, and the SEPA pre-notification. CONTACT_FROM_EMAIL is the sender for all of them; documents
# reply to the address in lib/admin/documents/company.ts.
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=website@example.com
