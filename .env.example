# Supabase — public values, safe to expose in the browser.
# Project: YM-Creations (wbrqbuctwzpobnvcsomt)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The service role key bypasses row level security. It is not used anywhere in
# this codebase and must not be added here.

# Resend — the contact form and sending quotes and invoices to customers.
# CONTACT_FROM_EMAIL is the sender for both; documents reply to the address in
# lib/admin/documents/company.ts.
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=website@example.com
