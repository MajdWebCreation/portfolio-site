# Supabase — public values, safe to expose in the browser.
# Project: YM-Creations (wbrqbuctwzpobnvcsomt)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase secret key — elevated, server-only access for system actions.
#
# Read in exactly one module, lib/payments/admin-client.ts, and used only by
# the two flows that carry no session: the Mollie webhook and the direct debit
# activation the customer starts. Neither can run as a signed-in admin, and the
# alternative -- granting `anon` write access to the payment tables -- would
# make internal financial administration publicly writable.
#
# That client reads no cookies and keeps no session, so it can never adopt a
# visitor's. Everything an admin does still goes through the ordinary server
# client and row level security.
#
# Never expose this to the browser, never put it in a NEXT_PUBLIC_ variable,
# never write it to the database, never log it and never put it in a mail.
SUPABASE_SECRET_KEY=sb_secret_...

# The absolute URL of this site. Mollie needs it to reach the webhook and to
# send customers back after paying.
NEXT_PUBLIC_SITE_URL=https://ymcreations.com

# Mollie — payments and direct debit. A key starting with test_ puts the whole
# integration in test mode, so development needs no separate switch.
# Server-side only: it is never sent to the browser, never written to the
# database, never logged and never put in a mail or a URL.
MOLLIE_API_KEY=test_...

# Vercel Cron — the daily SEPA pre-notification pass.
#
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on the scheduled
# call. Without it the route refuses every request rather than running open,
# so a missing value cannot turn it into a public button that mails customers.
# Generate a long random value; server-only.
CRON_SECRET=

# Resend — the contact form, sending quotes and invoices, the direct debit
# activation mail, and the SEPA pre-notification. CONTACT_FROM_EMAIL is the sender for all of them; documents
# reply to the address in lib/admin/documents/company.ts.
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=website@example.com
